{
  "targets": {
    "urls": [
      "http://localhost:8080",
      "https://test.example.com"
    ],
    "authToken": "",
    "cookies": {}
  },
  "scanProfiles": {
    "light": {
      "maxDepth": 2,
      "maxPages": 50,
      "timeoutSeconds": 10,
      "threads": 5,
      "fuzzParams": 20,
      "portRangeStart": 1,
      "portRangeEnd": 1024
    },
    "medium": {
      "maxDepth": 4,
      "maxPages": 200,
      "timeoutSeconds": 15,
      "threads": 10,
      "fuzzParams": 100,
      "portRangeStart": 1,
      "portRangeEnd": 1024
    },
    "deep": {
      "maxDepth": 8,
      "maxPages": 1000,
      "timeoutSeconds": 30,
      "threads": 20,
      "fuzzParams": 500,
      "portRangeStart": 1,
      "portRangeEnd": 65535
    }
  },
  "proxy": {
    "enabled": false,
    "url": "",
    "type": "HTTP",
    "username": "",
    "password": ""
  },
  "customHeaders": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.5"
  },
  "output": {
    "directory": "./reports",
    "format": "both",
    "includeRawResponse": false
  },
  "notifications": {
    "enabled": false,
    "webhookUrl": ""
  },
  "tls": {
    "minimumVersion": "Tls12",
    "allowUntrusted": false
  },
  "virustotal": {
    "apiKey": ""
  },
  "rateLimits": {
    "virustotalRequestsPerMinute": 4,
    "credentialRequestsPerSecond": 1,
    "defaultDelayMs": 100
  },
  "secretPatterns": [
    {"Type": "AWS Access Key", "Pattern": "AKIA[0-9A-Z]{16}", "Severity": "Critical"},
    {"Type": "GitHub Token (classic)", "Pattern": "ghp_[A-Za-z0-9]{36}", "Severity": "Critical"},
    {"Type": "GitHub Token (fine-grained)", "Pattern": "github_pat_[A-Za-z0-9_]{82,}", "Severity": "Critical"},
    {"Type": "Slack Webhook", "Pattern": "https://hooks\\.slack\\.com/services/T[A-Z0-9]+/B[A-Z0-9]+/[A-Za-z0-9]+", "Severity": "Critical"},
    {"Type": "Stripe Live Key", "Pattern": "sk_live_[A-Za-z0-9]{24,99}", "Severity": "Critical"},
    {"Type": "Stripe Test Key", "Pattern": "sk_test_[A-Za-z0-9]{24,99}", "Severity": "High"},
    {"Type": "Google API Key", "Pattern": "AIza[0-9A-Za-z\\-_]{35}", "Severity": "High"},
    {"Type": "JWT Secret", "Pattern": "(eyJ[A-Za-z0-9\\-_]+\\.eyJ[A-Za-z0-9\\-_]+\\.[A-Za-z0-9\\-_]+)", "Severity": "High"},
    {"Type": "Connection String (SQL)", "Pattern": "(Server|Data Source|Initial Catalog|Database|User ID|Password)\\s*=.+", "Severity": "High"},
    {"Type": "Connection String (Mongo)", "Pattern": "mongodb(?:\\+srv)?://[^/\\s\"<]+", "Severity": "Critical"},
    {"Type": "Connection String (Postgres)", "Pattern": "postgres(?:ql)?://[^/\\s\"<]+", "Severity": "Critical"},
    {"Type": "Private Key (RSA)", "Pattern": "-----BEGIN RSA PRIVATE KEY-----", "Severity": "Critical"},
    {"Type": "Private Key (EC)", "Pattern": "-----BEGIN EC PRIVATE KEY-----", "Severity": "Critical"},
    {"Type": "Private Key (DSA)", "Pattern": "-----BEGIN DSA PRIVATE KEY-----", "Severity": "Critical"},
    {"Type": "Private Key (OpenSSH)", "Pattern": "-----BEGIN OPENSSH PRIVATE KEY-----", "Severity": "Critical"},
    {"Type": "Generic Private Key", "Pattern": "-----BEGIN PRIVATE KEY-----", "Severity": "Critical"},
    {"Type": ".env Assignment", "Pattern": "^\\s*[A-Za-z0-9_]+\\s*=\\s*['\"]?[^'\"\\n]{8,}['\"]?\\s*$", "Severity": "High"},
    {"Type": "Bearer Token", "Pattern": "Bearer\\s+[A-Za-z0-9\\-_\\.]{20,}", "Severity": "High"},
    {"Type": "Basic Auth", "Pattern": "Basic\\s+[A-Za-z0-9+/=]{20,}", "Severity": "High"},
    {"Type": "Generic Password Assignment", "Pattern": "(?:password|passwd|pwd|api_key|apikey|secret|token)\\s*[:=]\\s*['\"]?[^'\"\\n\\r]{6,}['\"]?", "Severity": "High"}
  ],
