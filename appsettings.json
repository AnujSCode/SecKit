  "attackPatterns": [
    {"Name": "SQLi - SELECT/UNION", "Pattern": "(?i)(\\bSELECT\\b.*\\bFROM\\b|\\bUNION\\b.*\\bSELECT\\b)", "Category": "SQL Injection", "Severity": "Critical"},
    {"Name": "SQLi - DROP/ALTER", "Pattern": "(?i)\\b(DROP\\s+TABLE|ALTER\\s+TABLE|TRUNCATE\\s+TABLE)\\b", "Category": "SQL Injection", "Severity": "Critical"},
    {"Name": "SQLi - Comment bypass", "Pattern": "(?i)(--\\s|#\\s*$|/\\*.*\\*/)", "Category": "SQL Injection", "Severity": "Medium"},
    {"Name": "SQLi - Boolean", "Pattern": "(?i)(\\bOR\\b\\s+['\"]?\\d+['\"]?\\s*=\\s*['\"]?\\d+['\"]?|\\b1\\s*=\\s*1\\b)", "Category": "SQL Injection", "Severity": "Critical"},
    {"Name": "SQLi - UNION injection", "Pattern": "(?i)UNION\\s+(ALL\\s+)?SELECT\\s+(NULL|@@version|database\\(\\))", "Category": "SQL Injection", "Severity": "Critical"},
    {"Name": "SQLi - Time-based", "Pattern": "(?i)(\\bSLEEP\\s*\\(|WAITFOR\\s+DELAY|pg_sleep|BENCHMARK\\s*\\()", "Category": "SQL Injection", "Severity": "High"},
    {"Name": "SQLi - Error-based", "Pattern": "(?i)(CONVERT\\s*\\(\\s*int\\s*,\\s*@@version|extractvalue\\s*\\(|updatexml\\s*\\()", "Category": "SQL Injection", "Severity": "High"},
    {"Name": "SQLi - Stacked queries", "Pattern": "(?i);\\s*(DROP|EXEC|EXECUTE|SHUTDOWN)\\b", "Category": "SQL Injection", "Severity": "Critical"},
    {"Name": "XSS - Script tag", "Pattern": "(?i)<\\s*script[^>]*>.*?<\\s*/\\s*script\\s*>", "Category": "XSS", "Severity": "Critical"},
    {"Name": "XSS - Event handler", "Pattern": "(?i)\\bon\\w+\\s*=\\s*[^>]*\\b(alert|confirm|prompt|eval)\\s*\\(?", "Category": "XSS", "Severity": "Critical"},
    {"Name": "XSS - JavaScript protocol", "Pattern": "(?i)javascript\\s*:", "Category": "XSS", "Severity": "High"},
    {"Name": "XSS - IMG onerror", "Pattern": "(?i)<img[^>]*\\bonerror\\s*=", "Category": "XSS", "Severity": "Critical"},
    {"Name": "XSS - SVG onload", "Pattern": "(?i)<svg[^>]*\\bonload\\s*=", "Category": "XSS", "Severity": "Critical"},
    {"Name": "XSS - Iframe", "Pattern": "(?i)<\\s*iframe[^>]*>", "Category": "XSS", "Severity": "Medium"},
    {"Name": "XSS - Encoded", "Pattern": "(?i)%3Cscript%3E|&lt;script&gt;|\\\\x3cscript\\\\x3e", "Category": "XSS", "Severity": "Critical"},
    {"Name": "XSS - Expression", "Pattern": "(?i)expression\\s*\\([^)]*\\balert\\b", "Category": "XSS", "Severity": "High"},
    {"Name": "Path Traversal - Unix", "Pattern": "\\.\\./\\.\\./|\\.\\.\\\\\\.\\.\\\\", "Category": "Path Traversal", "Severity": "Critical"},
    {"Name": "Path Traversal - Encoded", "Pattern": "%2e%2e%2f|%2e%2e%5c|\\.%00/", "Category": "Path Traversal", "Severity": "Critical"},
    {"Name": "Path Traversal - etc/passwd", "Pattern": "(?i)/etc/(passwd|shadow|hosts|group)", "Category": "Path Traversal", "Severity": "Critical"},
    {"Name": "Path Traversal - Windows", "Pattern": "(?i)(win\\.ini|boot\\.ini|system32\\\\drivers)", "Category": "Path Traversal", "Severity": "Critical"},
    {"Name": "Command Injection - Pipe", "Pattern": "[;&|`]\\s*(ls|cat|id|whoami|uname|pwd|dir|type|ipconfig|ifconfig)\\b", "Category": "Command Injection", "Severity": "Critical"},
    {"Name": "Command Injection - Dollar", "Pattern": "\\$\\([a-zA-Z]", "Category": "Command Injection", "Severity": "High"},
    {"Name": "Command Injection - Backtick", "Pattern": "`[a-zA-Z]", "Category": "Command Injection", "Severity": "Critical"},
    {"Name": "Command Injection - Shell", "Pattern": "(?i)(\\bexec\\s*\\(|\\bsystem\\s*\\(|\\bshell_exec\\s*\\(|\\bpassthru\\s*\\()", "Category": "Command Injection", "Severity": "Critical"},
    {"Name": "Command Injection - cURL/wget", "Pattern": "(?i)(\\bcurl\\s+|wget\\s+|nc\\s+-|ncat\\s+)", "Category": "Command Injection", "Severity": "High"},
    {"Name": "LFI - PHP wrapper", "Pattern": "(?i)php://(filter|input|data)", "Category": "LFI", "Severity": "Critical"},
    {"Name": "LFI - expect wrapper", "Pattern": "(?i)expect://", "Category": "LFI", "Severity": "Critical"},
    {"Name": "RFI - Remote include", "Pattern": "(?i)https?://[^/\\s]+/[^?\\s]*\\.(php|txt)\\?", "Category": "RFI", "Severity": "Critical"},
    {"Name": "SSRF - Internal IP", "Pattern": "(?i)(127\\.0\\.0\\.\\d+|169\\.254\\.169\\.254|10\\.\\d+\\.\\d+\\.\\d+|172\\.(1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+|192\\.168\\.\\d+\\.\\d+)", "Category": "SSRF", "Severity": "High"},
    {"Name": "SSRF - Localhost", "Pattern": "(?i)localhost(\\b|:)", "Category": "SSRF", "Severity": "Medium"},
    {"Name": "SSRF - File protocol", "Pattern": "(?i)file:///", "Category": "SSRF", "Severity": "Critical"},
    {"Name": "SSRF - Gopher protocol", "Pattern": "(?i)gopher://", "Category": "SSRF", "Severity": "Critical"},
    {"Name": "XXE - Entity", "Pattern": "(?i)<!ENTITY\\s+\\w+\\s+(SYSTEM|PUBLIC)", "Category": "XXE", "Severity": "Critical"},
    {"Name": "XXE - DOCTYPE", "Pattern": "(?i)<!DOCTYPE\\s+\\w+\\s*\\[", "Category": "XXE", "Severity": "Critical"},
    {"Name": "File Upload - Web shell", "Pattern": "(?i)\\.(php\\d*|phtml|asp|x?msp|aspx|jsp|cfm|cgi|pl|py|rb)\\b", "Category": "File Upload", "Severity": "Critical"},
    {"Name": "File Upload - Config", "Pattern": "(?i)(\\.htaccess|web\\.config)", "Category": "File Upload", "Severity": "Critical"},
    {"Name": "Scanner - User Agent", "Pattern": "(?i)(nikto|nessus|nmap|sqlmap|acunetix|burp|w3af|dirbuster|gobuster|hydra|medusa|metasploit)", "Category": "Reconnaissance", "Severity": "Medium"},
    {"Name": "Scanner - Headers", "Pattern": "(?i)(X-Scanner:|X-Probe:|X-Forwarded-For:\\s*127\\.0\\.0\\.1)", "Category": "Reconnaissance", "Severity": "Low"},
    {"Name": "NoSQLi - Operator injection", "Pattern": "(?i)(\\$ne\\b|\\$gt\\b|\\$lt\\b|\\$regex\\b|\\$where\\b|\\$exists\\b)", "Category": "NoSQL Injection", "Severity": "High"},
    {"Name": "NoSQLi - JSON injection", "Pattern": "(?i)\\{\\s*\"\\$ne\":|\"\\$gt\":|\"\\$regex\":", "Category": "NoSQL Injection", "Severity": "High"},
    {"Name": "SSTI - Jinja2/Twig", "Pattern": "(?i)\\{\\{.*?\\}\\}|\\{%\\s*.*?\\s*%\\}", "Category": "Template Injection", "Severity": "Critical"},
    {"Name": "SSTI - FreeMarker", "Pattern": "(?i)\\$\\{.*?}", "Category": "Template Injection", "Severity": "Medium"},
    {"Name": "LDAPi - Filters", "Pattern": "(?i)(\\(&|\\\\(\\||!\\(|\\)\\()", "Category": "LDAP Injection", "Severity": "Medium"},
    {"Name": "Cookie - SQLi", "Pattern": "(?i)Cookie:\\s*.*?(--|' OR|\\bUNION\\b)", "Category": "Cookie Injection", "Severity": "Critical"}
  ],
