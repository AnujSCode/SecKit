{
  "targets": {
    "urls": [
      "http://localhost:8080",
      "https://test.example.com"
    ],
    "authToken": "",
    "cookies": {}
  },
  "scanProfiles": {
    "light": {
      "maxDepth": 2,
      "maxPages": 50,
      "timeoutSeconds": 10,
      "threads": 5,
      "fuzzParams": 20,
      "portRangeStart": 1,
      "portRangeEnd": 1024
    },
    "medium": {
      "maxDepth": 4,
      "maxPages": 200,
      "timeoutSeconds": 15,
      "threads": 10,
      "fuzzParams": 100,
      "portRangeStart": 1,
      "portRangeEnd": 1024
    },
    "deep": {
      "maxDepth": 8,
      "maxPages": 1000,
      "timeoutSeconds": 30,
      "threads": 20,
      "fuzzParams": 500,
      "portRangeStart": 1,
      "portRangeEnd": 65535
    }
  },
  "proxy": {
    "enabled": false,
    "url": "",
    "type": "HTTP",
    "username": "",
    "password": ""
  },
  "customHeaders": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.5"
  },
  "output": {
    "directory": "./reports",
    "format": "both",
    "includeRawResponse": false
  },
  "notifications": {
    "enabled": false,
    "webhookUrl": ""
  }
}
