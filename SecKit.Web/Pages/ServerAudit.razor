@page "/server-audit"
@implements IDisposable

<PageTitle>SecKit — Server Audit</PageTitle>

<h1>&#x1F6E0; Server Hardening Audit</h1>

<p class="text-muted" style="margin-bottom: 1.5rem;">
    This page shows server hardening results in an expandable dashboard format.
    Run a server audit scan to populate this view.
</p>

@if (_auditData == null && !_loading)
{
    <div class="panel text-center" style="padding: 2rem;">
        <p class="text-muted">No audit data available.</p>
        <button class="btn btn-primary" style="margin-top: 1rem;" @onclick="RunAudit">
            &#x1F50D; Run Server Audit
        </button>
    </div>
}
else if (_loading)
{
    <div class="panel text-center" style="padding: 3rem;">
        <div class="spinner"></div>
        <p class="text-muted" style="margin-top: 1rem;">Running server audit...</p>
    </div>
}
else if (_auditData != null)
{
    <!-- Overall Score -->
    <div class="card-grid">
        <div class="stat-card @(_auditData.OverallScore >= 80 ? "low" : _auditData.OverallScore >= 60 ? "medium" : _auditData.OverallScore >= 40 ? "high" : "critical")">
            <div class="stat-value">@_auditData.OverallScore%</div>
            <div class="stat-label">Overall Score</div>
        </div>
        <div class="stat-card critical">
            <div class="stat-value">@_auditData.Sections.Count(s => s.Severity == "critical")</div>
            <div class="stat-label">Critical Issues</div>
        </div>
        <div class="stat-card high">
            <div class="stat-value">@_auditData.Sections.Count(s => s.Severity == "high")</div>
            <div class="stat-label">Warnings</div>
        </div>
        <div class="stat-card low">
            <div class="stat-value">@_auditData.Sections.Count(s => s.Severity == "pass")</div>
            <div class="stat-label">Passed Checks</div>
        </div>
    </div>

    <!-- Expandable Sections -->
    <h2>Audit Details</h2>
    @foreach (var auditSection in _auditData.Sections)
    {
        var isOpen = _openSections.Contains(auditSection.Name);
        var severityColor = auditSection.Severity switch
        {
            "critical" => "var(--danger)",
            "high" => "var(--warning)",
            "medium" => "var(--info)",
            "pass" => "var(--success)",
            _ => "var(--text-secondary)"
        };
        var severityIcon = auditSection.Severity switch
        {
            "critical" => "&#x1F534;", "high" => "&#x1F7E0;", "medium" => "&#x1F535;",
            "pass" => "&#x1F7E2;", _ => "&#x26AB;"
        };

        <div class="expandable">
            <div class="expandable-header" @onclick="() => ToggleSection(auditSection.Name)">
                <div style="display:flex; align-items:center; gap:0.75rem;">
                    <span class="expandable-arrow @(isOpen ? "open" : "")">&#x25B6;</span>
                    <span style="color:@severityColor">@((MarkupString)severityIcon)</span>
                    <span>@auditSection.Name</span>
                </div>
                <span class="text-muted" style="font-size:0.8rem;">@auditSection.Status</span>
            </div>
            @if (isOpen)
            {
                <div class="expandable-body">
                    @if (!string.IsNullOrEmpty(auditSection.Description))
                    {
                        <p style="margin-bottom: 0.75rem;">@auditSection.Description</p>
                    }
                    @if (!string.IsNullOrEmpty(auditSection.Remediation))
                    {
                        var alertClass = auditSection.Severity == "critical" ? "alert-danger" : auditSection.Severity == "high" ? "alert-warning" : "alert-info";
                        <div class="alert @alertClass">
                            <strong>Recommendation:</strong> @auditSection.Remediation
                        </div>
                    }
                    @if (auditSection.Details.Any())
                    {
                        <table style="margin-top: 0.5rem;">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Value</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detail in auditSection.Details)
                                {
                                    <tr>
                                        <td>@detail.Key</td>
                                        <td class="text-mono">@detail.Value</td>
                                        <td>
                                            <span class="badge @(detail.Status == "OK" ? "badge-low" : detail.Status == "WARN" ? "badge-high" : "badge-critical")">
                                                @detail.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    }

    <button class="btn btn-secondary" style="margin-top: 1.5rem;" @onclick="RunAudit">
        &#x1F504; Re-run Audit
    </button>
}

@code {
    private ServerAuditData? _auditData;
    private HashSet<string> _openSections = new();
    private bool _loading;

    protected override void OnInitialized()
    {
        // Try to load existing audit data from disk
        LoadAuditFromFile();
    }

    private async Task RunAudit()
    {
        _loading = true;
        StateHasChanged();

        // Simulate audit with real system checks
        await Task.Delay(500); // Small delay for UI feedback
        _auditData = await CollectAuditDataAsync();
        _loading = false;

        // Save to disk
        try
        {
            var dir = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "reports");
            Directory.CreateDirectory(dir);
            var json = System.Text.Json.JsonSerializer.Serialize(_auditData, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            await File.WriteAllTextAsync(Path.Combine(dir, "server-audit.json"), json);
        }
        catch { /* non-critical */ }
    }

    private void LoadAuditFromFile()
    {
        try
        {
            var path = Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", "reports", "server-audit.json");
            if (File.Exists(path))
            {
                var json = File.ReadAllText(path);
                _auditData = System.Text.Json.JsonSerializer.Deserialize<ServerAuditData>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            }
        }
        catch { /* non-critical */ }
    }

    private void ToggleSection(string name)
    {
        if (_openSections.Contains(name))
            _openSections.Remove(name);
        else
            _openSections.Add(name);
    }

    private async Task<ServerAuditData> CollectAuditDataAsync()
    {
        var data = new ServerAuditData { Timestamp = DateTime.UtcNow };
        var sections = new List<AuditSection>();

        // SSH config check
        var sshSection = await CheckSshConfigAsync();
        sections.Add(sshSection);

        // Users check
        var usersSection = await CheckUsersAsync();
        sections.Add(usersSection);

        // Processes check
        var procsSection = await CheckProcessesAsync();
        sections.Add(procsSection);

        // Firewall check
        var fwSection = await CheckFirewallAsync();
        sections.Add(fwSection);

        // Open ports
        var portsSection = await CheckOpenPortsAsync();
        sections.Add(portsSection);

        // File permissions
        var permsSection = await CheckFilePermissionsAsync();
        sections.Add(permsSection);

        data.Sections = sections;

        // Calculate score
        var weights = new Dictionary<string, int>
        {
            ["critical"] = 0, ["high"] = 25, ["medium"] = 50, ["pass"] = 100
        };
        data.OverallScore = (int)sections.Average(s =>
            weights.GetValueOrDefault(s.Severity, 0));

        return data;
    }

    private async Task<AuditSection> CheckSshConfigAsync()
    {
        var section = new AuditSection { Name = "SSH Configuration", Severity = "pass", Status = "OK" };
        var details = new List<AuditDetail>();

        try
        {
            var content = await TryReadFileAsync("/etc/ssh/sshd_config");
            if (content == null)
            {
                section.Severity = "medium";
                section.Description = "Could not read SSH config. May not be installed.";
                section.Status = "UNKNOWN";
                return section;
            }

            var checks = new Dictionary<string, (string good, string bad)>
            {
                ["PermitRootLogin"] = ("no", "yes"),
                ["PasswordAuthentication"] = ("no", "yes"),
                ["PermitEmptyPasswords"] = ("no", "yes"),
                ["X11Forwarding"] = ("no", "yes"),
                ["MaxAuthTries"] = ("3", "6"),
                ["Protocol"] = ("2", "1")
            };

            foreach (var (key, (good, bad)) in checks)
            {
                var lines = content.Split('\n').Where(l => l.Trim().StartsWith(key));
                var value = lines.FirstOrDefault()?.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? "not set";
                var status = value.Equals(good, StringComparison.OrdinalIgnoreCase) ? "OK" :
                             value.Equals(bad, StringComparison.OrdinalIgnoreCase) ? "WARN" : "OK";

                details.Add(new AuditDetail { Key = key, Value = value, Status = status });

                if (status == "WARN")
                {
                    section.Severity = section.Severity == "critical" ? "critical" : "high";
                    section.Status = "Issues Found";
                    section.Remediation = $"Set {key} to recommended values in /etc/ssh/sshd_config and restart sshd.";
                }
            }

            section.Description = "SSH daemon configuration audit for security best practices.";
        }
        catch (Exception ex)
        {
            section.Severity = "medium";
            section.Description = $"Error checking SSH config: {ex.Message}";
        }

        section.Details = details;
        return section;
    }

    private async Task<AuditSection> CheckUsersAsync()
    {
        var section = new AuditSection { Name = "User Accounts", Severity = "pass", Status = "OK" };

        try
        {
            var passwd = await TryReadFileAsync("/etc/passwd");
            if (passwd == null)
            {
                section.Severity = "medium";
                section.Description = "Could not read /etc/passwd.";
                return section;
            }

            var lines = passwd.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var usersWithShell = lines
                .Select(l => l.Split(':'))
                .Where(p => p.Length >= 7 && !string.IsNullOrEmpty(p[6]) &&
                           !p[6].EndsWith("nologin") && !p[6].EndsWith("false"))
                .Select(p => new { User = p[0], Uid = p[2], Shell = p[6] })
                .ToList();

            var rootUsers = usersWithShell.Where(u => u.Uid == "0").ToList();
            var hasSudoGroup = await TryReadFileAsync("/etc/group") is string groups &&
                groups.Contains("sudo:");

            section.Details = new List<AuditDetail>
            {
                new() { Key = "Total Users", Value = lines.Length.ToString(), Status = "OK" },
                new() { Key = "Login-able Users", Value = usersWithShell.Count.ToString(), Status = usersWithShell.Count > 10 ? "WARN" : "OK" },
                new() { Key = "UID 0 (root) Accounts", Value = rootUsers.Count.ToString(), Status = rootUsers.Count > 1 ? "WARN" : "OK" }
            };

            if (usersWithShell.Count > 10)
            {
                section.Severity = "medium";
                section.Remediation = "Review user accounts with shell access. Remove unnecessary accounts.";
                section.Status = "Review";
            }
        }
        catch (Exception ex)
        {
            section.Severity = "medium";
            section.Description = $"Error: {ex.Message}";
        }

        return section;
    }

    private async Task<AuditSection> CheckProcessesAsync()
    {
        var section = new AuditSection { Name = "Running Processes", Severity = "pass", Status = "OK" };

        try
        {
            var suspicious = new[] { "miner", "crypto", "botnet", "backdoor", "reverse_shell" };
            var procOutput = await TryRunCommandAsync("ps", "aux");

            if (procOutput == null)
            {
                section.Severity = "medium";
                section.Description = "Could not list processes.";
                return section;
            }

            var lines = procOutput.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            var suspiciousFound = new List<string>();

            foreach (var line in lines.Skip(1)) // skip header
            {
                foreach (var s in suspicious)
                {
                    if (line.Contains(s, StringComparison.OrdinalIgnoreCase))
                        suspiciousFound.Add($"{s}: {line.Substring(0, Math.Min(80, line.Length))}");
                }
            }

            section.Details = new List<AuditDetail>
            {
                new() { Key = "Total Processes", Value = (lines.Length - 1).ToString(), Status = "OK" },
                new() { Key = "Suspicious Processes", Value = suspiciousFound.Count.ToString(),
                    Status = suspiciousFound.Any() ? "WARN" : "OK" }
            };

            if (suspiciousFound.Any())
            {
                section.Severity = "critical";
                section.Status = "Suspicious Activity";
                section.Description = string.Join("\n", suspiciousFound);
                section.Remediation = "Investigate suspicious processes immediately. Check for unauthorized access.";
            }
        }
        catch (Exception ex)
        {
            section.Severity = "medium";
            section.Description = $"Error: {ex.Message}";
        }

        return section;
    }

    private async Task<AuditSection> CheckFirewallAsync()
    {
        var section = new AuditSection { Name = "Firewall Status", Severity = "pass", Status = "OK" };

        try
        {
            var ufwOutput = await TryRunCommandAsync("ufw", "status");
            var iptablesCount = await TryRunCommandAsync("bash", "-c \"iptables -L 2>/dev/null | wc -l\"");

            var ufwActive = ufwOutput?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
            var iptablesRules = int.TryParse(iptablesCount?.Trim(), out var c) ? c : 0;

            section.Details = new List<AuditDetail>
            {
                new() { Key = "UFW Status", Value = ufwActive ? "Active" : "Inactive/Not installed",
                    Status = ufwActive ? "OK" : "WARN" },
                new() { Key = "iptables Rules", Value = iptablesRules.ToString(),
                    Status = iptablesRules > 0 ? "OK" : "WARN" }
            };

            if (!ufwActive && iptablesRules == 0)
            {
                section.Severity = "critical";
                section.Status = "No Firewall";
                section.Description = "No active firewall detected (neither ufw nor iptables rules).";
                section.Remediation = "Enable ufw or configure iptables immediately. Minimum: 'ufw enable && ufw default deny incoming && ufw default allow outgoing'.";
            }
            else if (!ufwActive)
            {
                section.Severity = "medium";
                section.Status = "iptables Only";
                section.Description = "UFW not active but iptables rules exist.";
            }
        }
        catch (Exception ex)
        {
            section.Severity = "medium";
            section.Description = $"Error: {ex.Message}";
        }

        return section;
    }

    private async Task<AuditSection> CheckOpenPortsAsync()
    {
        var section = new AuditSection { Name = "Open Ports", Severity = "pass", Status = "OK" };

        try
        {
            var ssOutput = await TryRunCommandAsync("ss", "-tlnp");
            if (ssOutput == null)
            {
                section.Severity = "medium";
                section.Description = "Could not check open ports.";
                return section;
            }

            var lines = ssOutput.Split('\n', StringSplitOptions.RemoveEmptyEntries).Skip(1).ToList();
            var details = new List<AuditDetail>();

            var dangerousPorts = new Dictionary<int, string>
            {
                [21] = "FTP", [23] = "Telnet", [445] = "SMB", [1433] = "MSSQL",
                [3306] = "MySQL (exposed)", [5432] = "PostgreSQL (exposed)", [6379] = "Redis (exposed)",
                [27017] = "MongoDB (exposed)", [11211] = "Memcached"
            };

            var hasDangerous = false;

            foreach (var line in lines)
            {
                var parts = line.Split(new[] { ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length < 4) continue;

                var listenAddr = parts[3];
                if (!listenAddr.Contains(':')) continue;

                var portStr = listenAddr.Split(':').Last();
                if (!int.TryParse(portStr, out var port)) continue;

                var bindAddr = listenAddr.Split(':')[0];
                var isExposed = bindAddr is "0.0.0.0" or "::" or "*";
                var isDangerous = dangerousPorts.ContainsKey(port);

                var status = isDangerous && isExposed ? "WARN" :
                            isExposed && port > 1024 ? "OK" : "OK";

                if (status == "WARN") hasDangerous = true;

                details.Add(new AuditDetail
                {
                    Key = $"Port {port}" + (isDangerous ? $" ({dangerousPorts[port]})" : ""),
                    Value = bindAddr,
                    Status = status
                });
            }

            section.Details = details;

            if (hasDangerous)
            {
                section.Severity = "critical";
                section.Status = "Exposed Services";
                section.Description = "Dangerous services are exposed on public interfaces.";
                section.Remediation = "Bind services to localhost (127.0.0.1) unless remote access is required. Use firewall to restrict access.";
            }
        }
        catch (Exception ex)
        {
            section.Severity = "medium";
            section.Description = $"Error: {ex.Message}";
        }

        return section;
    }

    private async Task<AuditSection> CheckFilePermissionsAsync()
    {
        var section = new AuditSection { Name = "Critical File Permissions", Severity = "pass", Status = "OK" };

        var criticalFiles = new Dictionary<string, string>
        {
            ["/etc/shadow"] = "root:shadow 640",
            ["/etc/passwd"] = "root:root 644",
            ["/etc/sudoers"] = "root:root 440",
            ["/etc/ssh/sshd_config"] = "root:root 600",
        };

        var details = new List<AuditDetail>();
        var hasIssues = false;

        foreach (var (path, expected) in criticalFiles)
        {
            try
            {
                if (!File.Exists(path))
                {
                    details.Add(new AuditDetail { Key = path, Value = "not found", Status = "OK" });
                    continue;
                }

                var stat = await TryRunCommandAsync("stat", $"-c '%a %U:%G' {path}");
                var perms = stat?.Trim().Replace("'", "") ?? "unknown";

                var isOk = perms == expected;
                details.Add(new AuditDetail
                {
                    Key = path,
                    Value = perms,
                    Status = isOk ? "OK" : "WARN"
                });

                if (!isOk) hasIssues = true;
            }
            catch
            {
                details.Add(new AuditDetail { Key = path, Value = "error", Status = "WARN" });
            }
        }

        section.Details = details;

        if (hasIssues)
        {
            section.Severity = "high";
            section.Status = "Permission Issues";
            section.Description = "Some critical files have non-standard permissions.";
            section.Remediation = "Review file permissions: chmod/chown as needed for security-critical files.";
        }

        return section;
    }

    private async Task<string?> TryReadFileAsync(string path)
    {
        try
        {
            if (File.Exists(path))
                return await File.ReadAllTextAsync(path);
        }
        catch { }
        return null;
    }

    private async Task<string?> TryRunCommandAsync(string command, string args)
    {
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = command,
                Arguments = args,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true
            };

            using var proc = System.Diagnostics.Process.Start(psi);
            if (proc == null) return null;

            var output = await proc.StandardOutput.ReadToEndAsync();
            await proc.WaitForExitAsync();
            return output;
        }
        catch
        {
            return null;
        }
    }

    public void Dispose() { }

    private class ServerAuditData
    {
        public DateTime Timestamp { get; set; }
        public int OverallScore { get; set; }
        public List<AuditSection> Sections { get; set; } = new();
    }

    private class AuditSection
    {
        public string Name { get; set; } = "";
        public string Severity { get; set; } = "pass"; // critical, high, medium, pass
        public string Status { get; set; } = "OK";
        public string Description { get; set; } = "";
        public string Remediation { get; set; } = "";
        public List<AuditDetail> Details { get; set; } = new();
    }

    private class AuditDetail
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
        public string Status { get; set; } = "OK";
    }
}
